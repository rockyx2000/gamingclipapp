{
  "name": "gamingclipapp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "typecheck": "npm run typecheck -w apps/api"
  },
  "engines": {
    "node": ">=22"
  }
}
